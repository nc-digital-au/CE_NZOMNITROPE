{
  "name": "nzomnirtope",
  "version": "0.1",
  "scripts": {
    "prestart": "node aspnetcore-https",
    "start": "run-script-os",
    "start:windows": "ng serve --port 44464 --ssl --ssl-cert \"%APPDATA%\\ASP.NET\\https\\%npm_package_name%.pem\" --ssl-key \"%APPDATA%\\ASP.NET\\https\\%npm_package_name%.key\"",
    "start:default": "ng serve --port 44464 --ssl --ssl-cert \"$HOME/.aspnet/https/${npm_package_name}.pem\" --ssl-key \"$HOME/.aspnet/https/${npm_package_name}.key\"",
    "build": "ng build --configuration production",
    "build:ssr": "ng run NZOMNITROPE:server:dev",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular-magic/ngx-gp-autocomplete": "^2.0.2",
    "@angular/animations": "^17.0.6",
    "@angular/cdk": "^17.0.4",
    "@angular/common": "^17.0.6",
    "@angular/compiler": "^17.0.6",
    "@angular/core": "^17.0.6",
    "@angular/forms": "^17.0.6",
    "@angular/google-maps": "^17.3.10",
    "@angular/material": "^17.2.0",
    "@angular/platform-browser": "^17.0.6",
    "@angular/platform-browser-dynamic": "^17.0.6",
    "@angular/router": "^17.0.6",
    "@googlemaps/js-api-loader": "^1.16.6",
    "@kolkov/angular-editor": "^2.1.0",
    "@types/google.maps": "^3.55.10",
    "angular-calendar": "^0.31.0",
    "angular-svg-icon": "^17.0.0",
    "angular-tabler-icons": "^2.7.0",
    "date-fns": "^2.29.3",
    "file-saver": "^2.0.5",
    "jspdf": "^2.5.1",
    "ngx-pagination": "^6.0.1",
    "ngx-permissions": "^13.0.1",
    "ngx-scrollbar": "^11.0.0",
    "rxjs": "~7.8.0",
    "sass": "^1.57.1",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.4"
  },
